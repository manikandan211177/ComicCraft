# ComicCraft safe offline demo configuration.
# Put real API credentials in the untracked local .env file only.
APP_NAME=ComicCraft - AI Comic Story Creator
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
GEMINI_API_KEY=
GEMINI_OUTLINE_MODEL=gemini-3.8-flash
GEMINI_STORY_MODEL=gemini-3.8-flash
HF_API_KEY=
IMAGE_PROVIDER=demo
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_WIDTH=768
IMAGE_HEIGHT=768
IMAGE_STEPS=4
DEMO_MODE=true
MAX_PANELS=5
